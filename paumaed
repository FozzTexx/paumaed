#
# Based on TNFS documentation here:
# https://github.com/spectrumero/spectranet/blob/master/tnfs/tnfs-protocol.md

import argparse
from server import TNFSServer
import os

TNFS_PORT = 16384
BIND_IP = "10.4.0.1"

def build_argparser():
  parser = argparse.ArgumentParser(formatter_class=argparse.ArgumentDefaultsHelpFormatter)
  parser.add_argument("share", help="directory to share")
  parser.add_argument("-b", "--bind", help="IP to bind to")
  parser.add_argument("--readonly", action="store_true", help="Disallow writing")
  return parser

def main():
  args = build_argparser().parse_args()

  if not os.path.isdir(args.share):
    print("Not a directory:", args.share)
    exit(1)

  bind_ip = args.bind
  if not bind_ip:
    bind_ip = BIND_IP
  server = TNFSServer(os.path.abspath(args.share), TNFS_PORT, bind_ip)
  server.run()

  return

if __name__ == '__main__':
  exit(main() or 0)
